.page {
  padding: 20rpx;
  padding-bottom: 24rpx;
}

.compare,
.stats,
.list,
.export {
  padding: 16rpx;
  margin-bottom: 12rpx;
}

.h {
  color: #5b89b6;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.compare-switch {
  display: flex;
  background: #edf6ff;
  border-radius: 999rpx;
  padding: 6rpx;
  margin-bottom: 10rpx;
}

.tab-btn {
  flex: 1;
  text-align: center;
  padding: 10rpx 0;
  color: #6285a8;
  border-radius: 999rpx;
  font-weight: 600;
}

.tab-active {
  background: #ffffff;
  color: #4f7398;
}

.preview-stage {
  position: relative;
  width: 100%;
}

.preview-node {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  background: #f4f9ff;
}

.effect-canvas {
  display: block;
}

.line {
  color: #5f748a;
  line-height: 1.6;
}

.row {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  gap: 10rpx;
}

.dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 1rpx solid #ececec;
}

.name {
  flex: 1;
  color: #596f86;
  font-size: 25rpx;
}

.count {
  color: #5b89b6;
  font-weight: 600;
}

.export-row {
  display: flex;
  gap: 16rpx;
}

.ex-btn {
  flex: 1;
}
