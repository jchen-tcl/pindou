.page {
  padding: 24rpx;
}

.section {
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.h {
  color: #5b89b6;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #f2f8ff;
  color: #5f748a;
  border: 2rpx solid #c8def3;
}

.chip-active {
  background: #8fc2f3;
  border-color: #8fc2f3;
  color: #fff;
}

.radio-item {
  display: flex;
  align-items: center;
  margin: 10rpx 0;
  gap: 8rpx;
}

.preview-box {
  margin-top: 8rpx;
}

.preview {
  width: 100%;
  height: 280rpx;
  border-radius: 16rpx;
  background: #f4f9ff;
}

.next {
  margin-top: 20rpx;
}
