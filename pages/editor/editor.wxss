.editor-page { height: 100vh; box-sizing: border-box; padding: 16rpx 20rpx calc(12rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; gap: 10rpx; }
.editor-heading { flex: none; }
.title { font-size: 32rpx; font-weight: 700; }
.dimensions { margin-left: 18rpx; color: #56778b; font-size: 24rpx; }
.subtitle, .hint, .position { font-size: 22rpx; color: #536779; }
.tools { display: flex; gap: 8rpx; flex: none; }
.tool { flex: 1; font-size: 24rpx; margin: 0; padding: 0 6rpx; line-height: 64rpx; background: #fff; color: #435f77; border-radius: 14rpx; }
.tool.selected { background: #337bab; color: #fff; }
.canvas-wrap { flex: 1; min-height: 100px; position: relative; background: #e6edf3; border: 2rpx solid #b7cedc; border-radius: 12rpx; overflow: hidden; }
.edit-canvas { width: 100%; height: 100%; }
.canvas-message { position: absolute; top: 45%; width: 100%; text-align: center; color: #526879; }
.view-controls { display: flex; align-items: center; gap: 8rpx; flex: none; }
.view-controls button { margin: 0; padding: 0 12rpx; font-size: 22rpx; line-height: 52rpx; color: #375c78; background: #fff; }
.view-controls text { font-size: 22rpx; min-width: 75rpx; text-align: center; }
.hint { min-height: 54rpx; }
.position { height: 32rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.palette-label { font-size: 24rpx; font-weight: 600; }
.palette-label text { font-size: 20rpx; font-weight: 400; color: #67798b; margin-left: 8rpx; }
.palette { flex: none; height: 94rpx; white-space: nowrap; }
.palette-row { display: inline-flex; gap: 8rpx; padding: 2rpx; }
.swatch { width: 66rpx; padding: 4rpx; border: 3rpx solid transparent; border-radius: 10rpx; text-align: center; font-size: 20rpx; }
.swatch-selected { border-color: #1d6fa5; background: #dceefb; }
.swatch-color { height: 36rpx; border: 1rpx solid #bbc7d1; border-radius: 5rpx; }
.editor-actions { display: flex; gap: 10rpx; flex: none; }
.editor-actions button { flex: 1; margin: 0; font-size: 26rpx; line-height: 66rpx; border-radius: 14rpx; }
.minor { background: #fff; color: #45627c; }
.save { background: #337bab; color: #fff; }
